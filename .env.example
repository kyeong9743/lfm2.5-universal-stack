# =====================================================================
#  LFM2.5-2.6B Universal Configuration
#  사용법: 이 파일을 .env 로 복사한 뒤, 아래 "하드웨어 프로파일" 중
#          해당 노드의 블록을 공통 설정 위에 덮어써서 사용한다.
# =====================================================================

# ---------------------------------------------------------------------
# 공통 (모든 노드 동일)
# ---------------------------------------------------------------------

# HuggingFace 원본 파일명 그대로 사용한다(대문자 주의).
# LiquidAI/LFM2.5-2.6B-GGUF → LFM2.5-2.6B-Q4_K_M.gguf (1.67GB)
MODEL_FILE=LFM2.5-2.6B-Q4_K_M.gguf

# llama.cpp 컨테이너 빌드 고정.
# LFM2.5 GGUF 는 b10262 로 양자화됨 → 반드시 b10262 이상이어야 아키텍처를 인식한다.
# amd64 / arm64 멀티아치 확인됨 (RPi5·Oracle A1 동일 태그 사용 가능).
IMAGE_TAG=server-b10423

# 서비스 노출 포트
PORT=8080

# 컨텍스트 윈도우. 모델 native 는 128K 이나 엣지 메모리 제약상 절삭해 쓴다.
# 메모리가 빠듯하면 2048 까지 내린다.
CTX_SIZE=4096

# 동시 처리 슬롯 수. 늘리면 KV 캐시가 슬롯 수만큼 곱해져 늘어난다.
PARALLEL_REQUESTS=1

# ---- 추론(reasoning) 제어 -------------------------------------------
# LFM2.5-2.6B 는 "pure reasoning model" 로, 답변 전 항상 <think> 블록을 생성한다.
#
# ※ "deepseek" 은 DeepSeek 모델과 무관하다. llama.cpp 가 정한 출력 포맷 이름일 뿐이며,
#   DeepSeek-R1 이 퍼뜨린 reasoning_content 필드 관례를 따른다는 뜻이다.
#
#   deepseek        : <think> 를 message.reasoning_content 로 분리 (권장)
#                     실측 - content 32자(답변만) / reasoning_content 1032자
#   none            : <think> 태그가 content 에 그대로 노출
#                     실측 - content 672자, "<think> The user is asking..." 로 시작
#   deepseek-legacy : 문서상 태그를 남긴다고 하나 실측은 deepseek 과 동일. 쓸 이유 없음
REASONING_FORMAT=deepseek

# 사고 토큰 예산. -1 = 무제한 / N = N 토큰에서 사고 강제 종료 / 0 = 즉시 종료.
#
# ★ 클라이언트가 max_tokens 를 작게(<2048) 보내는 환경이면 반드시 256 으로 제한할 것.
#   사고가 max_tokens 를 다 먹어버려 content 가 빈 문자열로 돌아온다(실측 확인).
#   저사양 노드에서 첫 답변까지의 지연을 줄이는 효과도 같이 있다.
THINK_BUDGET=-1

# ---- 샘플링 (모델 카드 권장값) ---------------------------------------
# 주의: 변수명을 TEMP 로 줄이면 안 된다. Docker Compose 는 셸 환경변수를 .env 보다
#       우선하므로 Windows 의 %TEMP%(임시폴더 경로)가 값을 덮어써 버린다.
SAMPLING_TEMP=0.1
SAMPLING_TOP_K=50
SAMPLING_REPEAT_PENALTY=1.1

# ---- 보안 -----------------------------------------------------------
# 비워두면 인증 없음.
# 요청 헤더: Authorization: Bearer <API_KEY>
API_KEY=

# /slots 모니터링 엔드포인트. 외부 노출 시 0 권장.
ENDPOINT_SLOTS=1

# CORS 허용 오리진. 기본값 '*' 는 서버가 기동 시 경고를 띄우므로 좁혀 둔다.
#   localhost                → 로컬 Web UI 전용 (기본)
#   https://ai.example.com   → NPM 으로 노출한 도메인만 허용
CORS_ORIGINS=localhost

# ---- GPU 옵션 (docker-compose.gpu.yml 을 같이 쓸 때만 적용) ------------
# docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --force-recreate
#   server-cuda-b10423   : CUDA 12 빌드 (RTX 5070 에서 확인)
#   server-cuda13-b10423 : CUDA 13 빌드
GPU_IMAGE_TAG=server-cuda-b10423
# GPU 에 올릴 레이어 수. 999 = 전부. VRAM 이 부족하면 줄인다 (전체 올릴 때 약 2GB 사용)
GPU_LAYERS=999


# =====================================================================
#  하드웨어 프로파일 — 아래에서 하나를 골라 값을 반영한다
# =====================================================================
#
# ┌ [A] Intel Core Ultra 7 258V (8C/8T, 32GB) 
# │   THREADS=6
# │   CPUSET=                Docker Desktop/WSL2 는 호스트 코어 번호와 매핑이 달라 미지정
# │   LOAD_MODE=none
# │   MEM_LIMIT=4g
# │   BIND_ADDR=127.0.0.1
# │   HEALTH_START_PERIOD=60s
# │
# ├ [B] Ryzen 9 9950X3D (16C/32T, 32GB) / RTX 5070 12GB
# │   THREADS=16
# │   CPUSET=
# │   LOAD_MODE=none
# │   MEM_LIMIT=4g
# │   BIND_ADDR=127.0.0.1
# │   HEALTH_START_PERIOD=60s
# │
# ├ [C] RPi5 : Cortex-A76 (4C/4T, 8GB) 
# │   THREADS=4
# │   CPUSET=0-2
# │   LOAD_MODE=none
# │   MEM_LIMIT=3g
# │   BIND_ADDR=127.0.0.1
# │   CTX_SIZE=2048
# │   THINK_BUDGET=256
# │   HEALTH_START_PERIOD=180s
# │
# ├ [D] Oracle Cloud A1 : Ampere Altra (2 OCPU, 12GB)
# │   THREADS=2
# │   CPUSET=
# │   LOAD_MODE=none
# │   MEM_LIMIT=3g
# │   BIND_ADDR=127.0.0.1
# │   THINK_BUDGET=256
# │   HEALTH_START_PERIOD=180s
# │
#
# =====================================================================


# ---------------------------------------------------------------------
# 현재 적용값 — [A]
# ---------------------------------------------------------------------
THREADS=6
CPUSET=
LOAD_MODE=none
MEM_LIMIT=4g
BIND_ADDR=127.0.0.1
HEALTH_START_PERIOD=60s
